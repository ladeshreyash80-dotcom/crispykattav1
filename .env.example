# Crispy Katta — environment variables
# Copy to .env (never commit .env) and fill in values.

# Supabase (optional). When set, the app persists menu/orders/feedback to
# Supabase Postgres. When unset, the app runs on the built-in local adapter
# (browser localStorage) so every feature still works out of the box.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Admin passcode for /admin (hashed with SHA-256 before comparison).
# When unset, the documented demo passcode "katta-admin" is accepted and a
# DEMO banner is shown inside the admin area.
VITE_ADMIN_PASSCODE=
